<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google's automatic cloud backup and phone-to-phone transfer. Only your
     data (favorites, stats, settings, lyrics), never the music or the sign-in cookie. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="library.xml" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="search.xml" />
        <include domain="sharedpref" path="session.xml" />
        <include domain="sharedpref" path="new_releases.xml" />
        <include domain="file" path="lyrics/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="library.xml" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="search.xml" />
        <include domain="sharedpref" path="session.xml" />
        <include domain="sharedpref" path="new_releases.xml" />
        <include domain="file" path="lyrics/" />
    </device-transfer>
</data-extraction-rules>
